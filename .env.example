# 32+ random chars. Signs session + login-challenge cookies. Required in production.
# Generate: openssl rand -hex 32
SESSION_SECRET=

# Postgres for chat messages (self-hosted Supabase on Hetzner). If unset, messages live in memory (dev only).
DATABASE_URL=

# Optional overrides
# ORDINALS_API_URL=https://ordinals.gorillapool.io/api
# NEXT_PUBLIC_CONTENT_URL=https://ordfs.network/content

# Optional marketplace fee on in-app purchases, paid to this address (e.g. 0.02 = 2%). Leave empty for no fee.
NEXT_PUBLIC_MARKET_FEE_ADDRESS=
NEXT_PUBLIC_MARKET_FEE_RATE=
